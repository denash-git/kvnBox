    # Fake site: Immich 3.3.6 (original web UI; sign-in never succeeds, nothing is stored)
    route {
        root * {{SITE_DIR}}
        header X-Powered-By "Express"

        # --- API ---
        @imm_login {
            method POST
            path /api/auth/login
            header Content-Type *json*
        }
        handle @imm_login {
            header Content-Type "application/json; charset=utf-8"
            header Vary "Accept-Encoding"
            header >ETag `"29-1Sh+NlZZU2g4pDo58tLlpj1RK10"`
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- .RespHeader.Set "X-Correlation-ID" (randAlphaNum 8 | lower) -]]{"message":"Incorrect email or password"}` 401
        }
        @imm_login_empty {
            method POST
            path /api/auth/login
        }
        handle @imm_login_empty {
            header Content-Type "application/json; charset=utf-8"
            header Vary "Accept-Encoding"
            header >ETag `"9f-lnRy7Y2jjlC73/CRTMbSQkgh+IU"`
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- .RespHeader.Set "X-Correlation-ID" (randAlphaNum 8 | lower) -]]{"message":"Validation failed","errors":[{"expected":"object","code":"invalid_type","path":[],"message":"Invalid input: expected object, received undefined"}]}` 400
        }
        @imm_oauth_mobile path /api/oauth/mobile-redirect
        handle @imm_oauth_mobile {
            header Location "app.immich:///oauth-callback?{http.request.uri.query}"
            respond `Temporary Redirect. Redirecting to app.immich:///oauth-callback?{http.request.uri.query}` 307
        }
        # публичные ссылки: ключ/слаг из адреса не подходит никогда
        @imm_key {
            path /api/*
            query key=*
        }
        handle @imm_key {
            header Content-Type "application/json; charset=utf-8"
            header Vary "Accept-Encoding"
            header >ETag `"1f-9/ws2d678SPMBMWxvMGG+P4oP1s"`
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- .RespHeader.Set "X-Correlation-ID" (randAlphaNum 8 | lower) -]]{"message":"Invalid share key"}` 401
        }
        @imm_slug {
            path /api/*
            query slug=*
        }
        handle @imm_slug {
            header Content-Type "application/json; charset=utf-8"
            header Vary "Accept-Encoding"
            header >ETag `"20-PCVrdZqEdeFBRBORANk43Sdfuvg"`
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- .RespHeader.Set "X-Correlation-ID" (randAlphaNum 8 | lower) -]]{"message":"Invalid share slug"}` 401
        }
