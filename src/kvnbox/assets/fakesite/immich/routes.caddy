        # --- веб-интерфейс ---
        # переводы, которых нет в шаблоне: английский (интерфейс открывается по-английски)
        @imm_i18n_fb path_regexp ^/_app/immutable/chunks/(?:40GSSPam\.js|5ltkkH9A\.js|6f2cNZyO\.js|6ypMAOtD\.js|7W1Ba1D7\.js|94g84NzG\.js|B\-lWUiv6\.js|B1SuEYXw\.js|B8zHthjo\.js|BDoO_Mxv\.js|BHx7pUVx\.js|BKgDGny0\.js|BKlMcCNG\.js|BL6JYhhS\.js|BMGWswfd\.js|BPbB04Rf\.js|BTrHmUd4\.js|BXG6Mv_Z\.js|BY72yCw1\.js|BYalYC9Y\.js|B_77pEGK\.js|B_xqpamc\.js|BbnjGLPY\.js|BgFoA7ux\.js|BmeuKm1q\.js|Bo1I1NIS\.js|BpdsZpp0\.js|C4k4xw3E\.js|C7jeZarq\.js|CAgm0JfQ\.js|CD9xD3Pj\.js|CHZdolgh\.js|CLax9WbI\.js|CO6C2jK8\.js|CWM0aJt3\.js|CWSNmXEq\.js|CgyK9c0t\.js|Clml2jpU\.js|CnHdpNFx\.js|CxtHkDpj\.js|D39T9C8I\.js|D7Avm6Z5\.js|D8KAN4lV\.js|DFc8E35L\.js|DGBbcDaU\.js|DKU9MoPO\.js|DMjmCK6p\.js|DOwCrGXH\.js|DRCmEnqD\.js|DT4fvs3W\.js|DU_Rw7u_\.js|DXLLDQDI\.js|Dh3O9aEH\.js|DiN031Mp\.js|Dp4ZHscC\.js|DpLgGl4U\.js|DweEj5q3\.js|Dx7shB6\-\.js|DyrMMBZJ\.js|FHP9KYnA\.js|J9VFn5OW\.js|LDoUcCId\.js|Rx1E\-wlO\.js|aJ2CgefM\.js|e3aLYwxi\.js|eCxWkgZK\.js|gRChG7U7\.js|x\-W4NXyJ\.js|zQR_f7xp\.js)$
        handle @imm_i18n_fb {
            header Cache-Control "public,max-age=31536000,immutable"
            header Content-Type "text/javascript"
            header Vary "Accept-Encoding"
            header -Etag
            rewrite * /_app/immutable/chunks/IX3RMfMS.js
            file_server
        }
        @imm_custom path /custom.css
        handle @imm_custom {
            header Content-Type "text/css; charset=utf-8"
            header ETag `"0-2jmj7l5rSw0yVb/vlWAYkK/YBwk"`
            header Vary "Accept-Encoding"
            respond 200
        }
        @imm_file {
            not path / /index.html /routes.caddy /NOTICE
            file
        }
        handle @imm_file {
            header Vary "Accept-Encoding"
            header -Etag
            header -Accept-Ranges
            @imm_immutable path /_app/immutable/*
            header @imm_immutable Cache-Control "public,max-age=31536000,immutable"
            @imm_js path *.js
            header @imm_js Content-Type "text/javascript"
            @imm_css path *.css
            header @imm_css Content-Type "text/css"
            @imm_json path *.json
            header @imm_json Content-Type "application/json"
            @imm_txt path *.txt
            header @imm_txt Content-Type "text/plain"
            @imm_ico path *.ico
            header @imm_ico >Content-Type ""
            file_server
        }
        # SPA: любой другой адрес — index.html (маршрутизация в браузере)
        handle {
            rewrite * /index.html
            header Content-Type "text/html; charset=utf-8"
            header Cache-Control "no-store"
            header >ETag `"2a60-7Kmx5Dd5WrxWbZ5qMo2bCKEGs4M"`
            header -Last-Modified
            header -Accept-Ranges
            file_server
        }
    }
