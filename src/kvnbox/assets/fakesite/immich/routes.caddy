            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- .RespHeader.Set "X-Correlation-ID" (randAlphaNum 8 | lower) -]]{"message":"Cannot [[ .Req.Method ]] [[ .Req.RequestURI | toJson | trimPrefix "\"" | trimSuffix "\"" ]]"}` 404
