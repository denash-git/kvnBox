        handle @sf_slash {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "text/html; charset=utf-8"
            header Location "{http.request.uri.path}/"
            respond 301
        }
        # остальное — родная страница 404 Seafile
        handle {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/nope-404.html /l/en/nope-404.html
            file_server {
                status 404
            }
        }
    }
