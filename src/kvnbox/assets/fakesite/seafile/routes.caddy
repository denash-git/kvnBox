    # Fake site: Seafile 11.0.13 behind nginx (original pages; sign-in never succeeds, nothing is stored)
    #! server nginx
    route {
        root * {{SITE_DIR}}

        # язык как у Django: кука django_language → Accept-Language → en
        map {http.request.header.Accept-Language} {sf_al} {
            ~(?i)^\s*zh-(tw|hk|mo|hant)  zh-tw
            ~(?i)^\s*zh                  zh-cn
            ~(?i)^\s*es-ar               es-ar
            ~(?i)^\s*es-mx               es-mx
            ~(?i)^\s*pt                  pt-br
            ~(?i)^\s*(ca|cs|de|en|es|fr|it|is|lv|hu|nl|pl|ru|sl|fi|sv|vi|tr|uk|he|ar|el|th|ko|ja)\b  ${1}
            default                      en
        }
        map {http.request.cookie.django_language} {sf_lang} {
            ~^(ca|cs|de|en|es|es-ar|es-mx|fr|it|is|lv|hu|nl|pl|pt-br|ru|sl|fi|sv|vi|tr|uk|he|ar|el|th|ko|ja|zh-cn|zh-tw)$  ${1}
            default {sf_al}
        }

        # статика (nginx отдаёт сам)
        @sf_media path /media/*
        handle @sf_media {
            @sf_media_file file
            handle @sf_media_file {
                header -Etag
                @sf_css path *.css
                header @sf_css Content-Type "text/css"
                @sf_js path *.js
                header @sf_js Content-Type "application/javascript"
                @sf_ttf path *.ttf
                header @sf_ttf Content-Type "text/plain"
                @sf_eot path *.eot
                header @sf_eot Content-Type "application/vnd.ms-fontobject"
                @sf_woff path *.woff
                header @sf_woff Content-Type "font/woff"
                @sf_woff2 path *.woff2
                header @sf_woff2 Content-Type "font/woff2"
                @sf_svg path *.svg
                header @sf_svg Content-Type "image/svg+xml"
                file_server
            }
            handle {
                rewrite * /nginx-404.html
                header Content-Type "text/html"
                file_server {
                    status 404
                }
            }
        }
        @sf_seafhttp path /seafhttp /seafhttp/*
        handle @sf_seafhttp {
            respond 404
        }
        @sf_seafdav path /seafdav /seafdav/*
        handle @sf_seafdav {
            rewrite * /nginx-502.html
            header Content-Type "text/html"
            header -Etag
            header -Last-Modified
            header -Accept-Ranges
            file_server {
                status 502
            }
        }

        # смена языка: кука на 30 дней и назад, откуда пришли
        @sf_i18n_ok {
            path /i18n/
            query lang=ca lang=cs lang=de lang=en lang=es lang=es-ar lang=es-mx lang=fr lang=it lang=is lang=lv lang=hu lang=nl lang=pl lang=pt-br lang=ru lang=sl lang=fi lang=sv lang=vi lang=tr lang=uk lang=he lang=ar lang=el lang=th lang=ko lang=ja lang=zh-cn lang=zh-tw
        }
        handle @sf_i18n_ok {
            header Content-Type "text/html; charset=utf-8"
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            templates {
                between [[ ]]
            }
            respond `[[- .RespHeader.Add "Set-Cookie" (printf "django_language=%s; expires=%s; Max-Age=2592000; Path=/" (.Req.URL.Query.Get "lang") (dateInZone "Mon, 02 Jan 2006 15:04:05 GMT" (now | dateModify "+720h") "UTC")) -]]
[[- .RespHeader.Set "Location" (.Req.Header.Get "Referer" | default "/") -]]` 302
        }
        @sf_i18n path /i18n/
        handle @sf_i18n {
            header Content-Type "text/html; charset=utf-8"
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            templates {
                between [[ ]]
            }
            respond `[[- .RespHeader.Set "Location" (.Req.Header.Get "Referer" | default "/") -]]` 302
        }

        # вход и сброс пароля: родные ответы оригинала; тело запроса не читается
        @sf_login_post {
            method POST
            path /accounts/login/
        }
        handle @sf_login_post {
            method GET
            header Content-Language {sf_lang}
            header Vary "Cookie, Accept-Language"
            rewrite * /l/{sf_lang}/POST_login.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_reset_post {
            method POST
            path /accounts/password/reset/
        }
        handle @sf_reset_post {
            method GET
            header Content-Language {sf_lang}
            header Vary "Cookie, Accept-Language"
            rewrite * /l/{sf_lang}/POST_reset.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_token_post {
            method POST
            path /api2/auth-token/
        }
        handle @sf_token_post {
            header Content-Type "application/json"
            header Allow "POST, OPTIONS"
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            respond `{"non_field_errors":["Unable to login with provided credentials."]}` 400
        }
        # прочие POST мимо API — у Django отказ CSRF
        @sf_csrf {
            method POST PUT PATCH DELETE
            not path /api/* /api2/*
        }
        handle @sf_csrf {
            method GET
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/POST_csrf.html /l/en/POST_csrf.html
            file_server {
                status 403
            }
        }

        header @sf_pages {
            -Etag
            -Last-Modified
            -Accept-Ranges
        }
        @sf_pages not path /media/*

        # все адреса Seafile (605 шаблонов Django) — ответы оригинала без входа
        @sf_r1 path_regexp ^(?:/accounts/activate/complete/)$
        handle @sf_r1 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__activate__complete.html /l/en/accounts__activate__complete.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r2 path_regexp ^(?:/accounts/activate/(?:\w+)/|/image-view/(?:.*)|/choose_register/|/api/v2.1/via-repo-token/dir/|/api/v2.1/via-repo-token/upload-link/|/api/v2.1/via-repo-token/repo-info/|/api/v2.1/via-repo-token/file/|/profile/two_factor_authentication/setup/complete/|/profile/two_factor_authentication/backup/tokens/|/share/ajax/get\-link\-audit\-code/)$
        handle @sf_r2 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "text/html; charset=utf-8"
            respond `<!DOCTYPE html>
<html lang="en">
<head>
    <title>Page unavailable</title>
</head>
<body>
    <h1>Page unavailable</h1>

    <p>Sorry, but the requested page is unavailable due to a server hiccup.</p>

    <p>Our engineers have been notified, so check back later.</p>
</body>
</html>
` 500
        }
        @sf_r3 path_regexp ^(?:/accounts/password/change/|/ocm\-via\-webdav/|/sso\-to\-thirdpart/|/|/repo/history/revert/(?:[-0-9a-f]{36})/|/repo/upload_check/|/repo/download_dir/(?:[-0-9a-f]{36})/|/repo/file_revisions/(?:[-0-9a-f]{36})/|/repo/sdoc_revision/(?:[-0-9a-f]{36})/|/repo/sdoc_revisions/(?:[-0-9a-f]{36})/|/repo/sdoc_export_to_docx/(?:[-0-9a-f]{36})/|/repo/file-access/(?:[-0-9a-f]{36})/|/repo/text_diff/(?:[-0-9a-f]{36})/|/repo/history/(?:[-0-9a-f]{36})/|/repo/history/view/(?:[-0-9a-f]{36})/|/repo/(?:[-0-9a-f]{36})/snapshot/|/repo/(?:[-0-9a-f]{36})/trash/|/repo/(?:[-0-9a-f]{36})/raw/(?:.*)|/lib/(?:[-0-9a-f]{36})/file(?:.*)|/wiki/lib/(?:[-0-9a-f]{36})/(?:.*)|/dingtalk/connect/|/dingtalk/connect\-callback/|/dingtalk/disconnect/|/convert_cmmt_desc_link/|/dashboard/|/my\-activities/|/starred/|/linked\-devices/|/share\-admin\-libs/|/share\-admin\-folders/|/share\-admin\-share\-links/|/share\-admin\-upload\-links/|/shared\-libs/|/shared\-with\-ocm/|/my\-libs/|/groups/|/library/(?:[-0-9a-f]{36})/|/library/(?:[-0-9a-f]{36})/(?:[^/]+)/(?:.*)|/my\-libs/deleted/|/org/|/invitations/|/avatar/add/|/notice/list/|/options/save/|/options/enable_sub_lib/|/profile/|/profile/[^/]+/get/|/profile/delete/|/profile/default\-repo/|/profile/two_factor_authentication/setup/|/profile/two_factor_authentication/qrcode/|/profile/two_factor_authentication/disable/|/profile/(?:[^/]*)/|/share/link/save/|/share/link/export\-excel/|/published/|/work\-weixin/oauth\-connect/|/work\-weixin/oauth\-connect\-callback/|/work\-weixin/oauth\-disconnect/|/drafts/|/sys/seafadmin/delete/(?:[-0-9a-f]{36})/|/sys/useradmin/export\-excel/|/sys/groupadmin/export\-excel/|/sys/sudo/|/useradmin/remove/[^/]+/|/useradmin/removeadmin/[^/]+/|/useradmin/password/reset/[^/]+/|/useradmin/batchadduser/example/|/sys/info/|/sys/statistics/file/|/sys/statistics/storage/|/sys/statistics/user/|/sys/statistics/traffic/|/sys/statistics/reports/|/sys/desktop\-devices/|/sys/mobile\-devices/|/sys/device\-errors/|/sys/notifications/|/sys/web\-settings/|/sys/all\-libraries/|/sys/search\-libraries/|/sys/system\-library/|/sys/trash\-libraries/|/sys/libraries/(?:[-0-9a-f]{36})/|/sys/libraries/(?:[-0-9a-f]{36})/(?:[^/]+)/(?:.*)|/sys/groups/|/sys/search\-groups/|/sys/departments/|/sys/users/|/sys/search\-users/|/sys/users/admins/|/sys/users/ldap/|/sys/users/ldap\-imported/|/sys/users/[^/]+/|/sys/users/[^/]+/owned\-libraries/|/sys/users/[^/]+/shared\-libraries/|/sys/users/[^/]+/shared\-links/|/sys/users/[^/]+/groups/|/sys/logs/login/|/sys/logs/file\-access/|/sys/logs/file\-update/|/sys/logs/share\-permission/|/sys/admin\-logs/operation/|/sys/admin\-logs/login/|/sys/organizations/|/sys/search\-organizations/|/sys/institutions/|/sys/terms\-and\-conditions/|/sys/share\-links/|/sys/upload\-links/|/sys/work\-weixin/|/sys/work\-weixin/departments/|/sys/dingtalk/|/sys/dingtalk/departments/|/sys/invitations/|/sys/abuse\-reports/|/sys/virus\-files/all/|/sys/virus\-files/unhandled/)$
        handle @sf_r3 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "text/html; charset=utf-8"
            header Location "/accounts/login/?next={http.request.uri.path}"
            respond 302
        }
        @sf_r4 path_regexp ^(?:/accounts/password/change/done/)$
        handle @sf_r4 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__password__change__done.html /l/en/accounts__password__change__done.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r5 path_regexp ^(?:/accounts/password/reset/)$
        handle @sf_r5 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__password__reset.html /l/en/accounts__password__reset.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r6 path_regexp ^(?:/accounts/password/reset/confirm/(?:[0-9A-Za-z]+)-(?:.+)/)$
        handle @sf_r6 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__password__reset__confirm__x1-abcdef0123456789abcd.html /l/en/accounts__password__reset__confirm__x1-abcdef0123456789abcd.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r7 path_regexp ^(?:/accounts/password/reset/complete/)$
        handle @sf_r7 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__password__reset__complete.html /l/en/accounts__password__reset__complete.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r8 path_regexp ^(?:/accounts/password/reset/done/)$
        handle @sf_r8 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__password__reset__done.html /l/en/accounts__password__reset__done.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r9 path_regexp ^(?:/accounts/login/two\-factor\-auth/|/profile/two_factor_authentication/verify/)$
        handle @sf_r9 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "text/html; charset=utf-8"
            header Location "/accounts/login/"
            respond 302
        }
        @sf_r10 path_regexp ^(?:/accounts/login/)$
        handle @sf_r10 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__login.html /l/en/accounts__login.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r11 path_regexp ^(?:/accounts/logout/)$
        handle @sf_r11 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__logout.html /l/en/accounts__logout.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r13 path_regexp ^(?:/accounts/register/complete/)$
        handle @sf_r13 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/accounts__register__complete.html /l/en/accounts__register__complete.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r14 path_regexp ^(?:/mobile\-login/)$
        handle @sf_r14 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/mobile-login.html /l/en/mobile-login.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r15 path_regexp ^(?:/sso/|/i18n/|/client\-login/)$
        handle @sf_r15 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "text/html; charset=utf-8"
            header Location "/"
            respond 302
        }
        @sf_r16 path_regexp ^(?:/work\-weixin\-sso/)$
        handle @sf_r16 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/work-weixin-sso.html /l/en/work-weixin-sso.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r17 path_regexp ^(?:/dingtalk\-sso/)$
        handle @sf_r17 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/dingtalk-sso.html /l/en/dingtalk-sso.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r18 path_regexp ^(?:/jwt\-sso/)$
        handle @sf_r18 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/jwt-sso.html /l/en/jwt-sso.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r19 path_regexp ^(?:/shib-login/)$
        handle @sf_r19 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "text/html; charset=utf-8"
            header Location "/sso/?next=&"
            respond 302
        }
        @sf_r20 path_regexp ^(?:/oauth/login/)$
        handle @sf_r20 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/oauth__login.html /l/en/oauth__login.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r21 path_regexp ^(?:/oauth/callback/)$
        handle @sf_r21 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            try_files /l/{sf_lang}/oauth__callback.html /l/en/oauth__callback.html
            templates {
                between [[ ]]
            }
            file_server
        }
        @sf_r22 path_regexp ^(?:/thirdparty\-editor/file\-info/|/thirdparty\-editor/file\-content/)$
        handle @sf_r22 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "application/json; charset=utf-8"
            header Allow "GET, HEAD, OPTIONS"
            respond `{}` 401
        }
        @sf_r23 path_regexp ^(?:/ocm\-via\-webdav/shares|/ocm\-via\-webdav/notifications|/api2/auth-token/|/api2/device\-wiped/|/api/v2.1/share-links/(?:[a-f0-9]+)/upload/done/|/api/v2.1/via-repo-token/sync-batch-move-item/|/api/v2.1/via-repo-token/sync-batch-copy-item/|/api/v2.1/cancel-zip-task/|/api/v2.1/ocm/shares/|/api/v2.1/ocm/notifications/|/api/v2.1/abuse-reports/)$
        handle @sf_r23 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "application/json"
            header Allow "POST, OPTIONS"
            respond `{"detail":"Method \"GET\" not allowed."}` 405
        }
        @sf_r24 path_regexp ^(?:/ocm\-via\-webdav/received\-shares/|/ocm\-via\-webdav/download\-received\-file/|/cad/api/file\-content/|/api2/auth/ping/|/api2/accounts/|/api2/search/|/api2/search\-user/|/api2/repos/(?:[-0-9a-f]{36})/history/|/api2/repos/(?:[-0-9a-f]{36})/download-info/|/api2/repos/(?:[-0-9a-f]{36})/download-shared-links/|/api2/repos/(?:[-0-9a-f]{36})/upload-shared-links/|/api2/repos/(?:[-0-9a-f]{36})/upload-link/|/api2/repos/(?:[-0-9a-f]{36})/update-link/|/api2/repos/(?:[-0-9a-f]{36})/update-blks-link/|/api2/repos/(?:[-0-9-a-f]{36})/owa-file/|/api2/repos/(?:[-0-9-a-f]{36})/file/metadata/|/api2/repos/(?:[-0-9-a-f]{36})/file/comments/counts/|/api2/repos/(?:[-0-9-a-f]{36})/file/detail/|/api2/repos/(?:[-0-9-a-f]{36})/file/history/|/api2/repos/(?:[-0-9-a-f]{36})/file/revision/|/api2/repos/(?:[-0-9-a-f]{36})/dir/metadata/|/api2/repos/(?:[-0-9-a-f]{36})/dir/sub_repo/|/api2/repos/(?:[-0-9-a-f]{36})/thumbnail/|/api2/shared\-repos/|/api2/beshared\-repos/|/api2/shared\-upload\-links/|/api2/repo\-tokens/|/api2/repo_history_changes/(?:[-0-9a-f]{36})/|/api2/unseen_messages/|/api/v2.1/smart-link/|/api/v2.1/search-file/|/api/v2.1/departments/|/api/v2.1/all-groups/|/api/v2.1/shareable-groups/|/api/v2.1/search-group/|/api/v2.1/repo-folder-share-info/|/api/v2.1/shared-folders/|/api/v2.1/shared-repos/|/api/v2.1/revision-tags/tag-names/|/api/v2.1/repos/|/api/v2.1/repos/(?:[-0-9a-f]{36})/file/history/|/api/v2.1/repos/(?:[-0-9a-f]{36})/file/new_history/|/api/v2.1/repos/(?:[-0-9a-f]{36})/dir/detail/|/api/v2.1/repos/(?:[-0-9a-f]{36})/history/|/api/v2.1/repos/(?:[-0-9a-f]{36})/related-users/|/api/v2.1/repos/(?:[-0-9a-f]{36})/share-links/|/api/v2.1/repos/(?:[-0-9a-f]{36})/upload-links/|/api/v2.1/repos/(?:[-0-9a-f]{36})/share-info/|/api/v2.1/recent-added-files/|/api/v2.1/query-copy-move-progress/|/api/v2.1/repos/(?:[-0-9a-f]{36})/shared/invitations/|/api/v2.1/repo/(?:[-0-9a-f]{36})/drafts/|/api/v2.1/repo/(?:[-0-9a-f]{36})/draft-counts/|/api/v2.1/activities/|/api/v2.1/ocm/shares-received/|/api/v2.1/admin/user-activities/|/api/v2.1/admin/abuse-reports/|/api/v2.1/admin/sysinfo/|/api/v2.1/admin/revision-tags/tagged-items/|/api/v2.1/admin/statistics/file-operations/|/api/v2.1/admin/statistics/total-storage/|/api/v2.1/admin/statistics/active-users/|/api/v2.1/admin/statistics/system-traffic/|/api/v2.1/admin/statistics/system-user-traffic/|/api/v2.1/admin/statistics/system-org-traffic/|/api/v2.1/admin/statistics/system-user-traffic/excel/|/api/v2.1/admin/statistics/system-user-storage/excel/|/api/v2.1/admin/ldap-users/|/api/v2.1/admin/search-user/|/api/v2.1/admin/admin-users/|/api/v2.1/admin/search-library/|/api/v2.1/admin/system-library/|/api/v2.1/admin/system-library/upload-link/|/api/v2.1/admin/search-group/|/api/v2.1/admin/departments/|/api/v2.1/admin/logs/login-logs/|/api/v2.1/admin/logs/file-access-logs/|/api/v2.1/admin/logs/file-update-logs/|/api/v2.1/admin/logs/share-permission-logs/|/api/v2.1/admin/admin-logs/|/api/v2.1/admin/admin-login-logs/|/api/v2.1/admin/share-links/|/api/v2.1/admin/share-links/(?:[a-f0-9]+)/download/|/api/v2.1/admin/share-links/(?:[a-f0-9]+)/dirents/|/api/v2.1/admin/upload-links/|/api/v2.1/admin/upload-links/(?:[a-f0-9]+)/upload/|/api/v2.1/admin/organizations-basic-info/|/api/v2.1/admin/search-organization/|/api/v2.1/admin/file-scan-records/|/api/v2.1/admin/virus-files/|/api/v2.1/admin/notifications/|/api/v2.1/admin/work-weixin/departments/|/api/v2.1/admin/dingtalk/departments/)$
        handle @sf_r24 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "application/json"
            header Allow "GET, HEAD, OPTIONS"
            respond `{"detail":"Authentication credentials were not provided."}` 403
        }
        @sf_r25 path_regexp ^(?:/robots\.txt)$
        handle @sf_r25 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
            header Content-Type "text/plain"
            respond `User-agent: *
Allow: /published/
Allow: /media/
Disallow: /
` 200
        }
        @sf_r26 path_regexp ^(?:/f/(?:[a-f0-9]+)/)$
        handle @sf_r26 {
            header Content-Language {sf_lang}
            header Vary "Accept-Language, Cookie"
