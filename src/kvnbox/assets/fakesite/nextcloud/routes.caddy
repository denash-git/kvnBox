        # --- остальное: родная страница 404 ---
        @nc_404_browser header Accept *text/html*
        handle @nc_404_browser {
            rewrite * /l/{nc_lang}/404.html
            header X-Powered-By "PHP/8.5.12"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'self';camera 'none';fullscreen 'self';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "text/html; charset=UTF-8"
            templates {
                between [[ ]]
            }
            file_server {
                status 404
            }
        }
        handle {
            try_files /l/{nc_lang}/404-prog.html /l/en/404-prog.html
            header X-Powered-By "PHP/8.5.12"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'self';camera 'none';fullscreen 'self';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "text/html; charset=UTF-8"
            templates {
                between [[ ]]
            }
            file_server {
                status 404
            }
        }
    }
