        @bk1 {
            vars nc_b k1
            header Accept *text/html*
        }
        handle @bk1 {
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Content-Type "text/xml; charset=UTF-8"
            header Feature-Policy "autoplay 'self';camera 'none';fullscreen 'self';geolocation 'none';microphone 'none';payment 'none'"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
