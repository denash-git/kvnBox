            header X-Powered-By "PHP/8.5.12"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "text/html; charset=UTF-8"
            header Location "/login?redirect_url={http.request.uri}"
            respond 303
        }
        @nce12p path_regexp ^/(?:index\.php/)?settings/(?:user|admin)$
        handle @nce12p {
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Content-Type "application/json; charset=utf-8"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
