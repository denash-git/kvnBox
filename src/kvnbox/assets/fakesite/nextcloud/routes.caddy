    # Fake site: Nextcloud 34.0.5 on Apache (original web UI; sign-in never succeeds, nothing is stored)
    #! server Apache/2.4.69 (Debian)
    route {
        root * {{SITE_DIR}}
        header {
            X-Content-Type-Options "nosniff"
            X-Frame-Options "SAMEORIGIN"
            X-Permitted-Cross-Domain-Policies "none"
            X-Robots-Tag "noindex, nofollow"
            Referrer-Policy "no-referrer"
        }

        # язык как у Nextcloud: первый поддерживаемый из Accept-Language
        map {http.request.header.Accept-Language} {nc_al} {
            ~(?i)^(?:[^,]*,)*?\s*(en-gb|de-de|es-mx|pt-br|pt-pt|zh-cn|zh-tw|zh-hans|zh-hant|ru|uk|be|en|de|fr|es|it|pt|pl|tr|zh|ja|nl|cs|fi)(?:[-_;,\s]|$)  ${1}
            default en
        }
        map {nc_al} {nc_lang} {
            ~(?i)^en-gb$    en_GB
            ~(?i)^de-de$    de_DE
            ~(?i)^es-mx$    es_MX
            ~(?i)^pt-br$    pt_BR
            ~(?i)^(pt-pt|pt)$  pt_PT
            ~(?i)^(zh-cn|zh-hans|zh)$  zh_CN
            ~(?i)^(zh-tw|zh-hant)$  zh_TW
            ~(?i)^ru$  ru
            ~(?i)^uk$  uk
            ~(?i)^be$  be
            ~(?i)^de$  de
            ~(?i)^fr$  fr
            ~(?i)^es$  es
            ~(?i)^it$  it
            ~(?i)^pl$  pl
            ~(?i)^tr$  tr
            ~(?i)^ja$  ja
            ~(?i)^nl$  nl
            ~(?i)^cs$  cs
            ~(?i)^fi$  fi
            default en
        }

        # --- статика (Apache отдаёт существующие файлы сам) ---
        @nc_plain0 {
            path /apps/theming/theme/*.css
            query plain=0
        }
        @nc_plain1 {
            path /apps/theming/theme/*.css
            query plain=1
        }
        handle @nc_plain0 {
            header X-Powered-By "PHP/8.5.12"
            header Content-Type "text/css;charset=UTF-8"
            header Cache-Control "private, max-age=86400, must-revalidate"
            header Content-Disposition `inline; filename=""`
            header -Etag
            header -Last-Modified
            header -Accept-Ranges
            rewrite * /s/_plain0{path}
            file_server
        }
        handle @nc_plain1 {
            header X-Powered-By "PHP/8.5.12"
            header Content-Type "text/css;charset=UTF-8"
            header Cache-Control "private, max-age=86400, must-revalidate"
            header Content-Disposition `inline; filename=""`
            header -Etag
            header -Last-Modified
            header -Accept-Ranges
            rewrite * /s/_plain1{path}
            file_server
        }
        @nc_favicon path /apps/theming/favicon /index.php/apps/theming/favicon
        handle @nc_favicon {
            header X-Powered-By "PHP/8.5.12"
            header Content-Type "image/x-icon"
            header Cache-Control "private, max-age=86400, must-revalidate"
            header Content-Disposition `inline; filename="favIcon-core#00679e"`
            header -Etag
            rewrite * /s/_dyn/apps/theming/favicon.bin
            file_server
        }
        @nc_icon path /apps/theming/icon /index.php/apps/theming/icon
        handle @nc_icon {
            header X-Powered-By "PHP/8.5.12"
            header Content-Type "image/png"
            header Cache-Control "private, max-age=86400, must-revalidate"
            header Content-Disposition `inline; filename="touchIcon-core#00679e"`
            header -Etag
            rewrite * /s/_dyn/apps/theming/icon.bin
            file_server
        }
        @nc_static {
            not path / */ /s/* /l/* /_*
            file /s{path}
        }
        handle @nc_static {
            header -Etag
            @nc_v {
                query v=*
                path *.js *.mjs *.css
            }
            header Cache-Control "max-age=15778463"
            header @nc_v Cache-Control "max-age=15778463, immutable"
            @nc_js path *.js *.mjs
            header @nc_js Content-Type "text/javascript"
            @nc_css path *.css
            header @nc_css Content-Type "text/css"
            @nc_ico path *.ico
            header @nc_ico Content-Type "image/vnd.microsoft.icon"
            rewrite * /s{path}
            file_server
        }

        # --- вход: никогда не проходит; логин только возвращается в адрес, как у оригинала ---
        @nc_root path / /index.php /index.php/
        handle @nc_root {
            header X-Powered-By "PHP/8.5.12"
            header Content-Type "text/html; charset=UTF-8"
            templates {
                between [[ ]]
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]][[- .RespHeader.Set "Content-Security-Policy" (printf "default-src 'self'; script-src 'self' 'nonce-%s'; style-src 'self' 'unsafe-inline'; frame-src *; img-src * data: blob:; font-src 'self' data:; media-src *; connect-src *; object-src 'none'; base-uri 'self';" (randBytes 32)) -]][[- .RespHeader.Set "Location" (printf "https://%s/login" .Host) -]]` 302
        }
        @nc_login_post {
            method POST
            path /login /index.php/login
        }
        handle @nc_login_post {
            header X-Powered-By "PHP/8.5.12"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header X-Nextcloud-Bruteforce-Throttled "200ms"
            header Content-Type "text/html; charset=UTF-8"
            templates {
                between [[ ]]
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]][[- .RespHeader.Set "Location" (printf "/login?direct=1&user=%s" (.Req.FormValue "user")) -]]` 303
        }
        @nc_login_err {
            path /login /index.php/login
            query direct=1
            query user=*
        }
        handle @nc_login_err {
            rewrite * /l/{nc_lang}/login-error.html
            header X-Powered-By "PHP/8.5.12"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'self';camera 'none';fullscreen 'self';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "text/html; charset=UTF-8"
            templates {
                between [[ ]]
            }
            file_server
        }
        @nc_login path /login /index.php/login
        handle @nc_login {
            rewrite * /l/{nc_lang}/login.html
            header X-Powered-By "PHP/8.5.12"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'self';camera 'none';fullscreen 'self';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "text/html; charset=UTF-8"
            templates {
                between [[ ]]
            }
            file_server
        }
        @nc_lost {
            method POST
            path /lostpassword/email /index.php/lostpassword/email
        }
        handle @nc_lost {
            header X-Powered-By "PHP/8.5.12"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header X-Nextcloud-Bruteforce-Throttled "200ms"
            header Content-Type "application/json; charset=utf-8"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"status":"success"}` 200
        }
        @nc_webauthn {
            method POST
            path /login/webauthn/start /index.php/login/webauthn/start
        }
        handle @nc_webauthn {
            header X-Powered-By "PHP/8.5.12"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "application/json; charset=utf-8"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"challenge":"[[ randBytes 32 | replace "+" "-" | replace "/" "_" | trimSuffix "=" ]]","rpId":"[[ .Host ]]","userVerification":"required","timeout":60000}` 200
        }
        @nc_loginv2 {
            method POST
            path /login/v2 /index.php/login/v2
        }
        handle @nc_loginv2 {
            header X-Powered-By "PHP/8.5.12"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "application/json; charset=utf-8"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"poll":{"token":"[[ randAlphaNum 128 ]]","endpoint":"https:\/\/[[ .Host ]]\/login\/v2\/poll"},"login":"https:\/\/[[ .Host ]]\/login\/v2\/flow\/[[ randAlphaNum 128 ]]"}` 200
        }
        @nc_csrf path /csrftoken /index.php/csrftoken
        handle @nc_csrf {
            header X-Powered-By "PHP/8.5.12"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "application/json; charset=utf-8"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"token":"[[ randBytes 32 | replace "/" "\\/" ]]:[[ randBytes 32 | replace "/" "\\/" ]]"}` 200
        }

        # --- служебные адреса вне маршрутизатора Nextcloud (снято с оригинала) ---
        @nce0 path_regexp ^/status\.php$
        handle @nce0 {
            header Content-Type "application/json"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]][[- $n := randBytes 32 -]][[- .RespHeader.Set "Content-Security-Policy" (printf "default-src 'self'; script-src 'self' 'nonce-%s'; style-src 'self' 'unsafe-inline'; frame-src *; img-src * data: blob:; font-src 'self' data:; media-src *; connect-src *; object-src 'none'; base-uri 'self';" $n) -]]{"installed":true,"maintenance":false,"needsDbUpgrade":false,"version":"34.0.5.1","versionstring":"34.0.5","edition":"","productname":"Nextcloud","extendedSupport":false}` 200
        }
        @nce1 path_regexp ^/cron\.php$
        handle @nce1 {
            header Content-Type "application/json; charset=utf-8"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]][[- $n := randBytes 32 -]][[- .RespHeader.Set "Content-Security-Policy" (printf "default-src 'self'; script-src 'self' 'nonce-%s'; style-src 'self' 'unsafe-inline'; frame-src *; img-src * data: blob:; font-src 'self' data:; media-src *; connect-src *; object-src 'none'; base-uri 'self';" $n) -]]{"status":"success"}` 200
        }
        @nce2 path_regexp ^/robots\.txt$
        handle @nce2 {
            header Content-Type "text/plain; charset=utf-8"
            respond `User-agent: *
Disallow: /
` 200
        }
        @nce3 path_regexp ^/ocs-provider/?$
        handle @nce3 {
            header Content-Type "application/json"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]][[- $n := randBytes 32 -]][[- .RespHeader.Set "Content-Security-Policy" (printf "default-src 'self'; script-src 'self' 'nonce-%s'; style-src 'self' 'unsafe-inline'; frame-src *; img-src * data: blob:; font-src 'self' data:; media-src *; connect-src *; object-src 'none'; base-uri 'self';" $n) -]]{"version":2,"services":{"PRIVATE_DATA":{"version":1,"endpoints":{"store":"\/ocs\/v2.php\/privatedata\/setattribute","read":"\/ocs\/v2.php\/privatedata\/getattribute","delete":"\/ocs\/v2.php\/privatedata\/deleteattribute"}},"SHARING":{"version":1,"endpoints":{"share":"\/ocs\/v2.php\/apps\/files_sharing\/api\/v1\/shares"}},"FEDERATED_SHARING":{"version":1,"endpoints":{"share":"\/ocs\/v2.php\/cloud\/shares","webdav":"\/public.php\/webdav\/","shared-secret":"\/ocs\/v2.php\/cloud\/shared-secret","system-address-book":"\/remote.php\/dav\/addressbooks\/system\/system\/system","carddav-user":"system"}},"ACTIVITY":{"version":1,"endpoints":{"list":"\/ocs\/v2.php\/cloud\/activity"}},"PROVISIONING":{"version":1,"endpoints":{"user":"\/ocs\/v2.php\/cloud\/users","groups":"\/ocs\/v2.php\/cloud\/groups","apps":"\/ocs\/v2.php\/cloud\/apps"}}}}` 200
        }
        @nce4 path_regexp ^/ocm-provider/?$
        handle @nce4 {
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Content-Type "application/json"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"enabled":true,"apiVersion":"1.0-proposal1","version":"1.1.0","endPoint":"https:\/\/{http.request.host}\/ocm","publicKey":{"keyId":"https:\/\/{http.request.host}:18080\/ocm#signature","publicKeyPem":"-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAmjdWLHbXm7YVeGe\/ffFl\nOlZKC0BBbUg7fGQtpkzIh06xA4XibwQxx1T0onabpgm94ebJkwLnqoQ2mBDraB8b\nCW8e7iRIr4A3LHmfl+NYXyb1z1RCAqxvhLzKhW7A\/jIdiW3L4x9yX4B9Ka96OjlY\n+YhMWrAmL8XTQstGgYse5icO\/tQrP5Q4\/hjUPlQOaQOGQZ1wpvK6f+Mz6XXJ47RZ\naeJW0QgFo2VWBLhCizN8KSf0l1YE+qEuKVbMD3j76gTB73+QBfqNN8JvTkXTg9sM\nPLban1+OFfSogI8NQS5dhHEDTW+H4Iasv2dd7Jc4DxHZPfWIz\/AQ2fYvW5BquT+T\nHwIDAQAB\n-----END PUBLIC KEY-----\n"},"provider":"Nextcloud 34.0.5.1","resourceTypes":[{"name":"file","shareTypes":["user","group"],"protocols":{"webdav":"\/public.php\/webdav\/"}}],"capabilities":["notifications","shares"]}` 200
        }
        @nce5 path_regexp ^/\.well-known/(?:caldav|carddav)$
        handle @nce5 {
            header Content-Type "text/html; charset=iso-8859-1"
            header Location "https://{http.request.host}/remote.php/dav/"
            templates {
                between [[ ]]
                mime text/html
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html><head>
<title>301 Moved Permanently</title>
</head><body>
<h1>Moved Permanently</h1>
<p>The document has moved <a href="https://{http.request.host}/remote.php/dav/">here</a>.</p>
<hr>
<address>Apache/2.4.69 (Debian) Server at {http.request.host} Port 443</address>
</body></html>
` 301
        }
        @nce6 path_regexp ^/\.well-known/webfinger$
        handle @nce6 {
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Content-Type "application/json; charset=utf-8"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"message":"webfinger not supported"}` 404
        }
        @nce7 path_regexp ^/\.well-known/nodeinfo$
        handle @nce7 {
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Content-Security-Policy "default-src 'none';base-uri 'none';manifest-src 'self';frame-ancestors 'none'"
            header Content-Type "application/json; charset=utf-8"
            header Feature-Policy "autoplay 'none';camera 'none';fullscreen 'none';geolocation 'none';microphone 'none';payment 'none'"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"message":"nodeinfo not supported"}` 404
        }
        @nce8b {
            path_regexp ^/remote\.php/(?:dav|caldav|carddav)(?:/.*)?$
            method GET
            header_regexp User-Agent (Chrome|Firefox|Safari|Edg|Trident|MSIE)
        }
        handle @nce8b {
            try_files /l/{nc_lang}/remote-dav.html /l/en/remote-dav.html
            header X-Powered-By "PHP/8.5.12"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'self';camera 'none';fullscreen 'self';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "text/html; charset=UTF-8"
            header WWW-Authenticate `Basic realm="Nextcloud", charset="UTF-8"`
            templates {
                between [[ ]]
            }
            file_server {
                status 401
            }
        }
        @nce8p path_regexp ^/remote\.php/(?:dav|caldav|carddav)(?:/.*)?$
        handle @nce8p {
            header Content-Security-Policy "default-src 'none';"
            header Content-Type "application/xml; charset=utf-8"
            header WWW-Authenticate `Basic realm="Nextcloud", charset="UTF-8"`
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/xml
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]<?xml version="1.0" encoding="utf-8"?>
<d:error xmlns:d="DAV:" xmlns:s="http://sabredav.org/ns">
  <s:exception>Sabre\DAV\Exception\NotAuthenticated</s:exception>
  <s:message>No public access to this resource., AppAPIAuth has not passed, This request is not for a federated calendar, No 'Authorization: Basic' header found. Either the client didn't send one, or the server is misconfigured, No 'Authorization: Bearer' header found. Either the client didn't send one, or the server is mis-configured, No 'Authorization: Basic' header found. Either the client didn't send one, or the server is misconfigured</s:message>
</d:error>
` 401
        }
        @nce9b {
            path_regexp ^/remote\.php/webdav(?:/.*)?$
            method GET
            header_regexp User-Agent (Chrome|Firefox|Safari|Edg|Trident|MSIE)
        }
        handle @nce9b {
            try_files /l/{nc_lang}/remote-dav.html /l/en/remote-dav.html
            header X-Powered-By "PHP/8.5.12"
            header Cache-Control "no-cache, no-store, must-revalidate"
            header Feature-Policy "autoplay 'self';camera 'none';fullscreen 'self';geolocation 'none';microphone 'none';payment 'none'"
            header Content-Type "text/html; charset=UTF-8"
            header WWW-Authenticate `Basic realm="Nextcloud", charset="UTF-8"`
            templates {
                between [[ ]]
            }
            file_server {
                status 401
            }
        }
        @nce9p path_regexp ^/remote\.php/webdav(?:/.*)?$
        handle @nce9p {
            header Content-Security-Policy "default-src 'none';"
            header Content-Type "application/xml; charset=utf-8"
            header WWW-Authenticate `Basic realm="Nextcloud", charset="UTF-8"`
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/xml
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]<?xml version="1.0" encoding="utf-8"?>
<d:error xmlns:d="DAV:" xmlns:s="http://sabredav.org/ns">
  <s:exception>Sabre\DAV\Exception\NotAuthenticated</s:exception>
  <s:message>No 'Authorization: Basic' header found. Either the client didn't send one, or the server is misconfigured, No 'Authorization: Bearer' header found. Either the client didn't send one, or the server is mis-configured</s:message>
</d:error>
` 401
        }
        @nce10b {
            path_regexp ^/public\.php$
            header Accept *text/html*
        }
        handle @nce10b {
            header Content-Security-Policy "default-src 'none';"
            header Content-Type "text/html; charset=UTF-8"
            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime text/html
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]<!DOCTYPE html>
<html class="ng-csp" data-placeholder-focus="false" lang="en" data-locale="en" translate="no" >
	<head
 data-requesttoken="">
		<meta charset="utf-8">
		<title>
			Nextcloud		</title>
		<meta name="csp-nonce" nonce="5QaiSfhAeSvtCcfmPwtzQwnuQl37gg45JQnLbqOVfds=">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
				<meta name="apple-itunes-app" content="app-id=1125420102">
				<meta name="theme-color" content="#00679e">
		<link rel="icon" href="/apps/theming/favicon?v=22f7c1d3">
		<link rel="apple-touch-icon" href="/apps/theming/icon?v=22f7c1d3">
		<link rel="mask-icon" sizes="any" href="/core/img/favicon-mask.svg" color="#00679e">
		<link rel="manifest" href="/core/img/manifest.json" crossorigin="use-credentials">
		<link rel="stylesheet" href="/core/css/styles.css?v=d87f58ac-0">
<link rel="stylesheet" href="/core/css/header.css?v=d87f58ac-0">
<link rel="stylesheet" href="/core/css/exception.css?v=d87f58ac-0">
<link rel="stylesheet" href="/apps/theming/css/default.css?v=29827a6f-0">
<link rel="stylesheet" href="/core/css/guest.css?v=d87f58ac-0">
					</head>
	<body id="body-login"  data-themes="">
		<noscript>
	<div id="nojavascript">
		<div>
			This application requires JavaScript for correct operation. Please <a href="https://www.enable-javascript.com/" target="_blank" rel="noreferrer noopener">enable JavaScript</a> and reload the page.		</div>
	</div>
</noscript>
		<div id="initial-state-container" style="display: none;">
			<input type="hidden" id="initial-state-core-versionHash" value="ImQ4N2Y1OGFjIg==">
			<input type="hidden" id="initial-state-comments-maxAutoCompleteResults" value="MTA=">
	</div>
		<div class="wrapper">
