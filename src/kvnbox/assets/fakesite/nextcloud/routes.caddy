            header X-Powered-By "PHP/8.5.12"
            templates {
                between [[ ]]
                mime application/json
            }
            respond `[[- $rid := randAlphaNum 20 -]][[- .RespHeader.Set "X-Request-Id" $rid -]]{"message":"{http.request.uri.path.1} not supported"}` 404
        }
