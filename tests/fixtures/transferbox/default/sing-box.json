{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "cloudflare-dns",
        "type": "https",
        "server": "1.1.1.1"
      },
      {
        "tag": "local-dns",
        "type": "local"
      }
    ]
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "naive-upstream-in",
      "listen": "127.0.0.1",
      "listen_port": 10001,
      "users": []
    },
    {
      "type": "vless",
      "tag": "vless-ws-in",
      "listen": "127.0.0.1",
      "listen_port": 10002,
      "users": [
        {
                "uuid": "00000000-0000-4000-8000-000000000002",
                "name": "admin@vless"
        },
        {
                "uuid": "00000000-0000-4000-8000-000000000003",
                "name": "mama@vless"
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/"
      }
    },
    {
      "type": "vless",
      "tag": "vless-grpc-in",
      "listen": "127.0.0.1",
      "listen_port": 10003,
      "users": [
        {
                "uuid": "00000000-0000-4000-8000-000000000004",
                "name": "mama@vless"
        }
      ],
      "transport": {
        "type": "grpc",
        "service_name": ""
      }
    },
    {
      "type": "vless",
      "tag": "vless-xhttp-in",
      "listen": "127.0.0.1",
      "listen_port": 10004,
      "users": [
        {
                "uuid": "00000000-0000-4000-8000-000000000005",
                "name": "mama@vless"
        }
      ],
      "transport": {
        "type": "httpupgrade",
        "host": "tst.example.com",
        "path": "/xhttp"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    },
    {
      "type": "block",
      "tag": "block-out"
    }
  ],
  "route": {
    "default_domain_resolver": "cloudflare-dns",
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "auto_detect_interface": true
  }
}
