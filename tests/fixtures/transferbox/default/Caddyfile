{
    order forward_proxy before handle
    grace_period 2s
    auto_https disable_redirects
}

# Main HTTPS server
:443, tst.example.com {
    tls {
        issuer acme {
            # anonymous ACME
            disable_http_challenge
        }
    }

    # NaiveProxy with credentials and upstream to sing-box
    forward_proxy {
        basic_auth admin_naive 000000000000000000000001
        basic_auth user_00000006 000000000000000000000006
        basic_auth user_00000009 000000000000000000000009
        hide_ip
        hide_via
        probe_resistance
        upstream socks5://127.0.0.1:10001
    }

    # Route VLESS gRPC by Content-Type header (allows running on root /)
    @grpc {
        header Content-Type application/grpc*
    }
    handle @grpc {
        reverse_proxy 127.0.0.1:10003 {
            transport http {
                versions h2c
            }
            @error status 400 401 403 502 503
            handle_response @error {
                root * /opt/transferbox/templates/fakesite/aether
                rewrite * /index.html
                file_server
            }
        }
    }

    # Route VLESS WS by Upgrade header and path (allows running on root /)
    @websocket {
        header Connection *Upgrade*
        header Upgrade    websocket
        path /
    }
    handle @websocket {
        reverse_proxy 127.0.0.1:10002 {
            @error status 400 401 403 502 503
            handle_response @error {
                root * /opt/transferbox/templates/fakesite/aether
                rewrite * /index.html
                file_server
            }
        }
    }

    # VLESS XHTTP (HTTPUpgrade) endpoint
    handle /xhttp {
        reverse_proxy 127.0.0.1:10004 {
            @error status 400 401 403 502 503
            handle_response @error {
                root * /opt/transferbox/templates/fakesite/aether
                rewrite * /index.html
                file_server
            }
        }
    }

    # Subscription route
    handle_path /sub/* {
        root * /opt/transferbox/sub
        file_server
        header Content-Type "text/plain; charset=utf-8"
    }

    # Fake site serving (SPA fallback for standard visits, scanners, probes)
    handle {
        root * /opt/transferbox/templates/fakesite/aether
        try_files {path} {path}/ /index.html
        file_server
    }

    # Hide server signature
    header -Server

    log {
        output stderr
        level ERROR
    }
}
